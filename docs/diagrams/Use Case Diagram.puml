@startuml

actor Guest
actor User
actor Admin
actor "Payment System" as Payment

rectangle "SmashGo System" {

    usecase "Browse Courts" as UC1
    usecase "View Court Details" as UC2
    usecase "View Available Time Slots" as UC3
    usecase "Book Court" as UC4
    usecase "Make Payment" as UC5
    usecase "Cancel Booking" as UC6
    usecase "View Booking History" as UC7
    usecase "Set Booking Reminder" as UC8
    usecase "Check In" as UC9
    usecase "Manage Courts" as UC10
    usecase "View Usage Statistics" as UC11
}

Guest --> UC1
Guest --> UC2
Guest --> UC3
Guest --> UC4

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC6
User --> UC7
User --> UC8
User --> UC9

Admin --> UC10
Admin --> UC11

Payment --> UC5

@enduml